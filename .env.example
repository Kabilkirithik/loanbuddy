# ==============================================================================
# Construction Site Inspection Vision Agent Environment Template
# ==============================================================================

# Commercial Detection APIs
INSPECT_SIGHTENGINE_API_USER=your_sightengine_user_id
INSPECT_SIGHTENGINE_API_SECRET=your_sightengine_api_secret
INSPECT_HIVE_API_KEY=your_hive_api_key

# Google Maps Static API Key
INSPECT_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Layer 1 Thresholds
INSPECT_DEPTH_MODEL_NAME=depth-anything/Depth-Anything-V2-Small-hf
INSPECT_DEPTH_EDGE_COINCIDENCE_MIN=1.10
INSPECT_PLANE_FIT_R2_MAX_THRESHOLD=0.88
INSPECT_DEPTH_STD_DEV_MIN_THRESHOLD=0.08
INSPECT_PARALLAX_MOTION_MIN_THRESHOLD=0.03

# Layer 2 Thresholds
INSPECT_SCREEN_RECAPTURE_MAX_CONFIDENCE=0.55
INSPECT_AI_GENERATED_MAX_CONFIDENCE=0.60
INSPECT_LOCAL_MOIRE_ENERGY_THRESHOLD=0.68

# Layer 3 Thresholds
INSPECT_GPS_TOLERANCE_METERS=100.0
INSPECT_LIGHTGLUE_MIN_INLIER_MATCHES=15
INSPECT_LIGHTGLUE_MIN_MATCH_CONFIDENCE=0.35

# System Execution (cpu, mps, cuda)
INSPECT_DEVICE=cpu
INSPECT_FAST_FAIL=false
